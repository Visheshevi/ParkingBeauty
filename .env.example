# Local backend config. `make dev` copies this to `.env` (git-ignored).
# Placeholders only; never put real secrets here. Later steps add keys as needed.

# dev | ci | test | prod (SPEC §12.7)
APP_ENV=dev

# HTTP ports for the Go services
API_PORT=8080
WORKER_PORT=8081
AGENT_PORT=8082

# Local Postgres from docker-compose (B0.2)
DATABASE_URL=postgres://pb:pb@localhost:5432/pb?sslmode=disable

# Logging: debug | info | warn | error
LOG_LEVEL=info
